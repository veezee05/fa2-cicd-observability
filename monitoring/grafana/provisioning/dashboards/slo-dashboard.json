{
  "uid": "fa2-slo",
  "title": "Lost & Found — SLO & Service Health",
  "tags": ["sre", "slo", "fa2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (SLI) — last 1h",
      "description": "avg of probe_success. SLO target: 99%.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.98 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time(probe_success{job=\"blackbox-http\"}[1h]))",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current status",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(probe_success{job=\"blackbox-http\"})",
          "legendFormat": "status"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error budget remaining (30d @ 99%)",
      "description": "Share of the monthly 1% downtime allowance still unspent.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(1 - ((1 - avg(avg_over_time(probe_success{job=\"blackbox-http\"}[30d]))) / 0.01), 0)",
          "legendFormat": "budget left"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency (SLI)",
      "description": "SLO target: under 1s.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile(0.95, probe_duration_seconds{job=\"blackbox-http\"})",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Probe success over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox-http\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"blackbox-http\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Host CPU usage",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Host memory used",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "memory"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "nginx requests handled",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total[5m])",
          "legendFormat": "requests/sec"
        }
      ]
    }
  ]
}
